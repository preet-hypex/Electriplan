{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electriplan.hypex.com.au/rulepacks/meta.schema.json",
  "title": "Rule pack metadata",
  "description": "meta.yaml: which release this is, the standards editions it encodes, its national rule files, and its state files with their sign-offs. A state is supported only when its file is signed off and unchanged since.",
  "type": "object",
  "required": ["id", "version", "status", "standards", "national", "states"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
    "status": {
      "description": "draft while values are being encoded; release once every mandatory value is verified (E0-S6, E0-S8).",
      "enum": ["draft", "release"]
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "edition"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "edition": { "type": "string", "minLength": 1 },
          "verified": { "description": "The edition is confirmed against a licensed copy.", "type": "boolean" }
        }
      }
    },
    "national": {
      "description": "The national rule files, beside meta.yaml.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.yaml$" }
    },
    "states": {
      "type": "object",
      "propertyNames": { "enum": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"] },
      "additionalProperties": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "^state/[A-Z]{2,3}\\.yaml$" },
        "signOff": {
          "description": "A licensed electrician from that state signed this file off. sha256 is of the file as signed: any later change voids the sign-off.",
          "type": "object",
          "required": ["by", "licence", "date", "sha256"],
          "additionalProperties": false,
          "properties": {
            "by": { "type": "string", "minLength": 1 },
            "licence": { "type": "string", "minLength": 1 },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
